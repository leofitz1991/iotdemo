{
  "uid": "iot-env",
  "title": "IoT Environment - InfluxDB 3",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Temperature (avg)",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT date_bin(INTERVAL '1 minute', time) AS time, AVG(temperature) AS value FROM environment WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "rawQuery": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Humidity (avg)",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT date_bin(INTERVAL '1 minute', time) AS time, AVG(humidity) AS value FROM environment WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "rawQuery": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Air quality (avg)",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT date_bin(INTERVAL '1 minute', time) AS time, AVG(air_quality) AS value FROM environment WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "rawQuery": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
