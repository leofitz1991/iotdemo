# Copy to .env and replace all placeholders before starting the Influx profile.
# Keep .env out of version control. Generate distinct, strong random credentials/tokens.
INFLUXDB_ADMIN_USER=airquality
INFLUXDB_ADMIN_PASSWORD=replace-with-a-long-random-password
INFLUXDB_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Created after InfluxDB starts by running: node create_influx_write_token.mjs
INFLUXDB_WRITE_TOKEN=
WRITER_API_TOKEN=replace-with-another-long-random-token
INFLUXDB_ORG=airquality-iot
INFLUXDB_BUCKET=airquality
# Keep ThingsBoard login credentials out of this file; export TB_USERNAME/TB_PASSWORD in your shell.
